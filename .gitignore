# ============================================================
# UNIFIED MONOREPO .gitignore
# Multimodal Agentic RAG for Circuit & Blueprint Analysis
# ============================================================

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.pytest_cache

# --- Node / Frontend Dependencies & Builds ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Java / Spring Boot Target & Build Artifacts ---
target/
backend/target/
build/
backend/build/
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- IDEs & OS Files ---
.idea/
*.iws
*.iml
*.ipr
.vscode/
!.vscode/extensions.json
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Application Data & Storage Dirs ---
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/test-uploads/*
!backend/data/test-uploads/.gitkeep
backend/data/db/*
!backend/data/db/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/test-uploads/*
!data/test-uploads/.gitkeep
data/db/*
!data/db/.gitkeep

# --- Runtime Outputs & Temporary Files ---
*.log
logs/
ml-service/vision_engine/outputs/*
!ml-service/vision_engine/outputs/.gitkeep
ml-service/predictions/
ml-service/vision_engine/app/_test_pdf/
outputs/
runs/

# --- Large Datasets & Archives (Strictly local, never in Git) ---
all_images/
data set 1/
data set 2/
final_circuit_dataset/
datasets/
ml-service/vision_engine/datasets/
*.zip
*.tar
*.tar.gz
*.jsonl
annotations.jsonl
dataset1.png
dataset2.png

# --- Model Weights Exclusions & Inclusions ---
# Exclude arbitrary weights and training checkpoints
*.pt
*.pth
*.onnx
*.engine
*.weights
*.bin
*.safetensors
# Explicitly whitelist the production model weights required for inference
!ml-service/vision_engine/models/circuit_yolov8n_preliminary.pt
!ml-service/vision_engine/models/yolov8n.pt

# --- Secrets & Environment Configurations ---
.env
*.env
.env.production
.env.local
.env.*.local
!.env.example
!frontend/.env.example
secrets.yaml
config_local.yaml
